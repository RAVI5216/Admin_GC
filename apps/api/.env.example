# Server Configuration
PORT=5000
NODE_ENV=development

# AWS Configuration (DynamoDB Region)
AWS_REGION=ap-southeast-2

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_here

# Local Evaluation / Development OTP Bypass
# Set to true to bypass email verification OTP during login (Recommended for faculty review)
DISABLE_EMAIL_OTP=true
# Optional master OTP code if OTP is enabled (e.g. 123456)
DEV_OTP_CODE=123456

# SMTP Email Configuration (Optional if DISABLE_EMAIL_OTP=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM="Garbage Guardian Team <your_email@gmail.com>"

# IoT Service Connection
SMARTBIN_IOT_SERVICE_URL=http://52.62.227.19:3001

# Admin Seed Script Configuration (Optional: for running npm run seed-admin)
ADMIN_EMAIL=admin@smartbin.local
ADMIN_NAME=Faculty Evaluator
ADMIN_PASSWORD=AdminPassword123!
